# Deny everything by default. Every Docker build input must be explicitly
# allowlisted below.
**

# Production node image (Dockerfile.node).
!.docker-build/iuna-node-linux-x86_64
!README.md
!LICENSE

# Local testnet node image (Dockerfile.local-testnet).
!Cargo.toml
!Cargo.lock
!rust-toolchain.toml
!src/**
!config/update-signing.key.pub

# Static website (Dockerfile).
!www/**
!wallet/**
!downloads/**
!scripts/inject_cloudflare_analytics.py
!src-tauri/icons/128x128@2x.png
!src-tauri/icons/icon.ico
!src-tauri/icons/icon.svg
!nginx.conf

# Never send host build caches, even when a negated source pattern above is
# interpreted broadly by a Docker/BuildKit version.
target/**
src-tauri/target/**
fuzz/target/**
