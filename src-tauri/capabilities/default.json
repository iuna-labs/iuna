{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Allow the main window and local management UI to use the desktop updater and open external links.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:8080/*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-check-desktop-update",
    "allow-install-desktop-update",
    "shell:allow-open"
  ]
}
