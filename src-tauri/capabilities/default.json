{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Allow the main window and local management UI to run the bundled sidecar and desktop updater.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:18661/*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-check-desktop-update",
    "allow-install-desktop-update",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/iuna-sidecar",
          "sidecar": true,
          "args": []
        }
      ]
    }
  ]
}
